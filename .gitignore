# ==========================================
# SetGo Monorepo - Root .gitignore
# ==========================================

# Claude AI tooling
.claude/

# ==========================================
# Dependencies
# ==========================================
node_modules/
jspm_packages/
bower_components/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
*.env
.env.backup
.env.production.backup

# ==========================================
# Security - Keys & Certificates
# ==========================================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
keys/
secrets/
.secrets/
credentials.json

# ==========================================
# Build Output
# ==========================================
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.parcel-cache/
.vite/

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Runtime & Cache
# ==========================================
tmp/
temp/
.cache/
.temp/
pids/
*.pid
*.seed
*.pid.lock
*.rdb
dump.rdb

# ==========================================
# Test Coverage
# ==========================================
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/

# ==========================================
# OS Files
# ==========================================
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
ehthumbs.db

# ==========================================
# Editor / IDE
# ==========================================
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.project
.classpath
.c9/
*.launch
.settings/
*.tmproj
.history/
*.swp
*.swo
*~

# ==========================================
# Package Managers
# ==========================================
.npm/
.yarn-integrity
.eslintcache
.node_repl_history
*.tgz

# ==========================================
# Uploads & User Content
# ==========================================
uploads/
public/uploads/
src/assets/uploads/

# ==========================================
# Image Backups (large originals)
# ==========================================
**/originals_backup/

# ==========================================
# Database
# ==========================================
*.sqlite
*.sqlite3
*.db

# ==========================================
# Deployment
# ==========================================
.serverless/
.terraform/
.pm2/

# ==========================================
# Sessions
# ==========================================
sessions/
.sessions/

# ==========================================
# Backup Files
# ==========================================
backup/
backups/
*.backup
*.bak
*.old
*.orig

# ==========================================
# CI/CD & GitHub internal
# ==========================================
.github/

# ==========================================
# Docs (generated/internal)
# ==========================================
CONTRIBUTING.md
PRODUCTION_DEPLOYMENT_SUMMARY.md
