NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

AZERICARD_GATEWAY_URL=https://test.azericard.com/gateway
AZERICARD_TERMINAL_ID=YOUR_TERMINAL_ID_HERE
AZERICARD_MERCHANT_NAME=Satgo Marketplace
AZERICARD_MERCHANT_URL=https://yourdomain.com

RSA_PRIVATE_KEY_PATH=./keys/private.pem
RSA_PUBLIC_KEY_PATH=./keys/public.pem

MONGODB_URI=mongodb://localhost:27017/payment_service

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=PASTE_GENERATED_SECRET_HERE
API_KEY=PASTE_GENERATED_KEY_HERE
WEBHOOK_SECRET=PASTE_GENERATED_SECRET_HERE
ENCRYPTION_KEY=PASTE_GENERATED_KEY_HERE

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX_REQUESTS=10

APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

LOG_LEVEL=info