# ========================================
# Satgo Backend - Environment Variables
# ========================================
# IMPORTANT: Never commit the actual .env file to version control!
# Copy this file to .env and fill in your actual values

# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=8080

# ========================================
# DATABASE
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority

# ========================================
# JWT & AUTHENTICATION
# ========================================
# Generate these with: node scripts/generateSecrets.js
# NEVER use weak secrets like "secret" or "password"
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
REFRESH_TOKEN_SECRET=your-super-secure-refresh-token-secret-min-32-chars

# ========================================
# SESSION & COOKIES
# ========================================
SESSION_SECRET=your-super-secure-session-secret
COOKIE_SECRET=your-super-secure-cookie-secret

# ========================================
# FRONTEND CORS
# ========================================
# Production frontend URL (used for CORS)
FRONTEND_URL=http://localhost:5173

# ========================================
# PAYMENTS
# ========================================
# Platform wallet: admins may transfer from it (releasing held funds), and it holds the wallet
# part of a wallet + card checkout until the bank answers. Required for mixed card payments.
Admin_Id=

# Card payments (Azericard). See AZERICARD_PAYMENT_WALLET_PLAN.md.
# AZERICARD_MODE: mock (local fake bank, refused in production) | test | live
AZERICARD_ENABLED=false
AZERICARD_MODE=mock
# Our private key (PEM file path relative to backend/, or the PEM itself in AZERICARD_PRIVATE_KEY).
# Never commit it. Optional in mock mode (an in-memory key is generated).
AZERICARD_PRIVATE_KEY_PATH=keys/azericard/private.pem
# test/live only:
# AZERICARD_GATEWAY_URL=
# AZERICARD_STATUS_URL=
# AZERICARD_TERMINAL=
# AZERICARD_BANK_PUBLIC_KEY_PATH=   (Azericard's public key, for verifying callbacks)
# AZERICARD_MERCH_NAME=SATGO
# AZERICARD_MERCH_URL=https://satgo.az
# Minutes before an unanswered card payment is checked with the bank (default 20)
# AZERICARD_STALE_MINUTES=20

# ========================================
# FILE STORAGE (Cloudinary)
# ========================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ========================================
# EMAIL SERVICE (Optional)
# ========================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-app-password

# ========================================
# ENCRYPTION (Optional but recommended)
# ========================================
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data
API_KEY_SECRET=your-api-key-secret

# ========================================
# THIRD-PARTY APIs (Add as needed)
# ========================================
# Add any other third-party service credentials here
# Examples:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_MAPS_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ========================================
# NOTES FOR PRODUCTION
# ========================================
# 1. Set NODE_ENV=production in production
# 2. Use strong, randomly generated secrets (run: node scripts/generateSecrets.js)
# 3. Never expose this file publicly
# 4. Use a secrets manager in production (AWS Secrets Manager, Azure Key Vault, etc.)
# 5. Rotate secrets regularly (every 90 days recommended)
# 6. Limit FRONTEND_URL to your actual production domain
# 7. Enable MongoDB IP whitelisting (not 0.0.0.0/0)
# 8. Use HTTPS for all production URLs
