# ========================================
# Satgo Frontend - Environment Variables Template
# ========================================
# Copy this file to .env.local for local development
# Never commit your actual .env files to version control

# Backend API URL
VITE_SERVER=http://localhost:8080

# Frontend URL
VITE_FRONTEND=http://localhost:5173

# Socket.IO URL (usually same as backend)
VITE_SOCKET=http://localhost:8080

# Google Maps API Key (https://console.cloud.google.com/google/maps-apis)
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ========================================
# ENVIRONMENTS:
# ========================================
# - Development: .env (already exists)
# - Staging: .env.staging
# - Production: .env.production
#
# Vite automatically loads the correct file based on mode
